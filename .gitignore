# ===================== 操作系统 / 编辑器 =====================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log

# ===================== Python =====================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# ===================== 环境变量 / 密钥 =====================
# 本地密钥、LLM API Key 等请勿入库（代码仅从环境变量读取）
.env
.env.*
*.local

# ===================== 本地数据（含密钥与用户数据） =====================
# data/ 下的 SQLite 会持久化 LLM API Key 与用户的户型数据，禁止入库
data/
*.db
*.sqlite
*.sqlite3

# ===================== 用户上传文件 =====================
# uploads/ 为运行期用户上传的户型图，禁止入库
uploads/

# ===================== 工作区私有记忆（含个人信息） =====================
.workbuddy/

# ===================== 前端构建产物 =====================
node_modules/
dist/
build/
*.bundle.js
